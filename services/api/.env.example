# Doctor Help API Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# Reverse proxy trust (set to 1 when behind nginx)
TRUST_PROXY=1

# MongoDB Connection
# Option 1: Local MongoDB
MONGO_URI=mongodb://localhost:27017/doctor-help

# Option 2: MongoDB Atlas
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/doctor-help?retryWrites=true&w=majority

# JWT Secret (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Cloudinary configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# User ID counter collection (managed in DB, not as env var)

# OTP Settings
OTP_DEV_MODE=true

# Reviewer OTP (for Play Console app access). Keep disabled unless under review.
REVIEW_OTP_ENABLED=false
# Preferred: multiple reviewer accounts
# Format: <10digitMobile>:<6digitOtp>,<10digitMobile>:<6digitOtp>
REVIEW_OTP_PAIRS=
# Backward-compatible single reviewer account
REVIEW_OTP_MOBILE=
REVIEW_OTP_VALUE=00000000



# Fast2SMS Configuration
FAST2SMS_API_KEY=your_api_key_from_fast2sms
FAST2SMS_SENDER_ID=your_dlt_approved_sender_id
FAST2SMS_TEMPLATE_ID=your_dlt_template_id
FAST2SMS_USE_DLT=true
# Route mode: auto | dlt | quick
FAST2SMS_ROUTE_MODE=dlt
FAST2SMS_TEMPLATE_TEXT=Your OTP for DoctorHelp login is {#var#}. It is valid for 10 minutes.

# Payment settings
# demo = simulated instant success, no external calls (used by admin PaymentDemo page + local dev).
# cashfree = real Cashfree Payment Gateway integration.
PAYMENT_MODE=demo

# Cashfree Payment Gateway
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=your_cashfree_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret
# Confirm the current value in the Cashfree merchant dashboard (Developers > API docs) before going live.
CASHFREE_API_VERSION=your_cashfree_api_version
CASHFREE_WEBHOOK_URL=https://your-domain.com/api/payments/webhook/cashfree

# Reserved for a future reconciliation job (not built yet — see payment integration plan)
PAYMENT_IDEMPOTENCY_TTL_MINUTES=30
PAYMENT_RECON_CRON=0 */6 * * *
